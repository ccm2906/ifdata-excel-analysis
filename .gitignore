~$*.xlsx
~$*.xls
~$*.xlsm
~$*.csv

# Arquivos de backup automáticos do Excel
*.xlk
*.tmp

# (Opcional) Ignorar arquivos CSV ou bases de dados gigantes se você preferir não buildá-los no Git
# data/
# *.csv
# *.tsv

